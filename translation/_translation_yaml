dataset_path: Helsinki-NLP/tatoeba_mt
training_split: validation
test_split: test
output_type: generate_until
metric_list:
  - metric: bleu
    aggregation: !function utils.pooled_bleu
    higher_is_better: true
  - metric: chrf
    aggregation: !function utils.pooled_chrf
    higher_is_better: true
  - metric: bleu_stderr
    aggregation: !function utils.bleu_stderr
    higher_is_better: false
  - metric: chrf_stderr
    aggregation: !function utils.chrf_stderr
    higher_is_better: false
generation_kwargs:
  until:
    - "\n"
  do_sample: true
  temperature: 1.0
  top_p: 1.0
  top_k: 0
  max_new_tokens: 256
metadata:
  version: 1.2
